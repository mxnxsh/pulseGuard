    {
      "name": "Docs",
      "item": [
        {
          "name": "OpenAPI spec (YAML)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/openapi.yaml", "host": ["{{baseUrl}}"], "path": ["openapi.yaml"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
