            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/organizations/{{orgId}}/notification-channels",
              "host": ["{{baseUrl}}"],
              "path": ["organizations", "{{orgId}}", "notification-channels"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ops email\",\n  \"config\": { \"to\": \"oncall@example.com\" },\n  \"enabled\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.code === 201);",
                  "pm.test('recipient is redacted', () => /\\*\\*\\*@/.test(pm.response.json().channel.config.to));",
                  "pm.collectionVariables.set('channelId', pm.response.json().channel.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/organizations/{{orgId}}/notification-channels/{{channelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["organizations", "{{orgId}}", "notification-channels", "{{channelId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.code === 200);"]
              }
            }
          ]
        },
        {
          "name": "Update (admin+)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/organizations/{{orgId}}/notification-channels/{{channelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["organizations", "{{orgId}}", "notification-channels", "{{channelId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.code === 200);"]
              }
            }
          ]
        },
