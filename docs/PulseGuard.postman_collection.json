{
  "info": {
    "name": "PulseGuard API",
    "description": "PulseGuard backend collection. Requests are chained via collection variables: run **Auth → Register** first (or Login) and it captures `accessToken` and `refreshToken`. **Organizations → List** captures `orgId`. **Projects → Create** captures `projectId`. **Monitors → Create** captures `monitorId`. **Notification Channels → Create** captures `channelId`. After that every other request just works. Point `baseUrl` at your environment (defaults to `http://localhost:3000/api/v1`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "testEmail", "value": "", "type": "string" },
    { "key": "testPassword", "value": "Password123", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "orgId", "value": "", "type": "string" },
    { "key": "projectId", "value": "", "type": "string" },
    { "key": "monitorId", "value": "", "type": "string" },
    { "key": "incidentId", "value": "", "type": "string" },
    { "key": "channelId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global: ensure a testEmail exists for register requests.",
          "if (!pm.collectionVariables.get('testEmail')) {",
          "  pm.collectionVariables.set('testEmail', 'postman_' + Date.now() + '@pulseguard.test');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health/live", "host": ["{{baseUrl}}"], "path": ["health", "live"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.code === 200);",
                  "pm.test('status ok', () => pm.response.json().status === 'ok');"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/health/ready", "host": ["{{baseUrl}}"], "path": ["health", "ready"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or 503', () => [200, 503].includes(pm.response.code));",
                  "pm.test('reports database check', () => pm.response.json().checks && 'database' in pm.response.json().checks);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (creates user + org + owner membership)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"fullName\": \"Postman User\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Force a fresh email for each Register run.",
                  "pm.collectionVariables.set('testEmail', 'postman_' + Date.now() + '@pulseguard.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.code === 201);",
                  "const res = pm.response.json();",
                  "pm.test('returns tokens', () => res.accessToken && res.refreshToken);",
                  "pm.collectionVariables.set('accessToken', res.accessToken);",
                  "pm.collectionVariables.set('refreshToken', res.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.code === 200);",
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', res.accessToken);",
                  "pm.collectionVariables.set('refreshToken', res.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh (rotates the token; old one becomes revoked)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.code === 200);",
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', res.accessToken);",
                  "pm.collectionVariables.set('refreshToken', res.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout (revokes the entire token family)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204 No Content', () => pm.response.code === 204);"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get current user (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.code === 200);",
                  "pm.test('returns user', () => pm.response.json().user && pm.response.json().user.email);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Organizations",
