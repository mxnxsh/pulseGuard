    },
    {
      "name": "Negative examples (expected failures)",
      "description": "Requests that should be rejected. Useful for verifying security controls.",
      "item": [
        {
          "name": "SSRF: private target should be rejected (in production)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/organizations/{{orgId}}/projects/{{projectId}}/monitors",
              "host": ["{{baseUrl}}"],
              "path": ["organizations", "{{orgId}}", "projects", "{{projectId}}", "monitors"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Loopback\",\n  \"url\": \"http://127.0.0.1/\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// In production 400 UNSAFE_TARGET is expected. In dev with",
                  "// MONITOR_ALLOW_PRIVATE_TARGETS=true the request may succeed —",
                  "// so we accept 201 as well and note it in the console.",
                  "pm.test('400 or 201 (dev override)', () => [201, 400].includes(pm.response.code));",
                  "if (pm.response.code === 201) console.warn('Private targets allowed in this env.');"
                ]
              }
            }
          ]
        },
        {
          "name": "Auth: bad password returns 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"WrongPassword123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.code === 401);",
                  "pm.test('code=INVALID_CREDENTIALS', () => pm.response.json().error.code === 'INVALID_CREDENTIALS');"
                ]
              }
            }
          ]
        },
        {
          "name": "Auth: /users/me without token returns 401",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401 Unauthorized', () => pm.response.code === 401);"]
              }
            }
          ]
        }
      ]
    }
