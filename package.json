{
  "name": "pulseguard",
  "version": "0.1.0",
  "description": "API monitoring and incident-management SaaS (backend-first, JavaScript CommonJS).",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "main": "apps/api/src/server.js",
  "scripts": {
    "start": "node apps/api/src/server.js",
    "dev": "nodemon apps/api/src/server.js",
    "worker": "node apps/worker/src/worker.js",
    "db:migrate": "node database/migrate.js up",
    "db:rollback": "node database/migrate.js down",
    "db:reset": "node database/migrate.js reset",
    "db:status": "node database/migrate.js status",
    "db:seed": "node database/seed.js",
    "maintenance:prune": "node scripts/prune.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:ssrf && npm run test:main",
    "test:main": "jest --config jest.main.config.js --runInBand",
    "test:ssrf": "jest --config jest.ssrf.config.js --runInBand"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  }
}
